  "content": "---\n# NoMachine Installation\n# Downloads the official .deb from download.nomachine.com and installs it.\n# Tags: nomachine, complex, applications, remote-access\n\n- name: \"{{ user_experience.emoji_package | default('\ud83d\udce6') }} NOMACHINE | Installing NoMachine...\"\n  block:\n    - name: Check if NoMachine is already installed\n      ansible.builtin.command:\n        cmd: dpkg -l {{ nomachine.package_name }}\n      register: nomachine_check\n      failed_when: false\n      changed_when: false\n\n    - name: \"{{ user_experience.emoji_working | default('\ud83d\udd04') }} NOMACHINE | Ensuring temp directory exists...\"\n      ansible.builtin.file:\n        path: \"{{ temp_download_dir }}\"\n        state: directory\n        mode: '0755'\n      when: nomachine_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_working | default('\ud83d\udd04') }} NOMACHINE | Downloading .deb package...\"\n      ansible.builtin.get_url:\n        url: \"{{ nomachine.deb_url }}\"\n        dest: \"{{ temp_download_dir }}/nomachine.deb\"\n        mode: '0644'\n        timeout: \"{{ error_handling.download_timeout | default(300) }}\"\n      register: nomachine_download\n      retries: \"{{ error_handling.download_retries | default(3) }}\"\n      delay: \"{{ error_handling.download_delay | default(5) }}\"\n      when: nomachine_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_package | default('\ud83d\udce6') }} NOMACHINE | Installing .deb package...\"\n      ansible.builtin.apt:\n        deb: \"{{ temp_download_dir }}/nomachine.deb\"\n        state: present\n      become: yes\n      when: nomachine_check.rc != 0\n      register: nomachine_install\n\n    - name: \"{{ user_experience.emoji_check | default('\ud83d\udd0d') }} NOMACHINE | Verifying installation...\"\n      ansible.builtin.command:\n        cmd: dpkg -l {{ nomachine.package_name }}\n      register: nomachine_verify\n      changed_when: false\n      failed_when: nomachine_verify.rc != 0\n      when: nomachine_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_success | default('\u2705') }} NOMACHINE | Successfully installed\"\n      ansible.builtin.lineinfile:\n        path: \"{{ logging.audit_trail }}\"\n        line: \"[{{ ansible_date_time.iso8601 }}] NOMACHINE: {{ nomachine.package_name }} - SUCCESS\"\n        create: true\n        mode: '0644'\n      when:\n        - nomachine_check.rc != 0\n        - logging.enabled | default(true)\n\n    - name: \"{{ user_experience.emoji_info | default('\u2139\ufe0f') }} NOMACHINE | Installation skipped (already installed)\"\n      ansible.builtin.debug:\n        msg: \"NoMachine is already installed - skipping installation\"\n      when: nomachine_check.rc == 0\n\n  rescue:\n    - name: \"{{ user_experience.emoji_failure | default('\u274c') }} NOMACHINE | Installation failed\"\n      ansible.builtin.lineinfile:\n        path: \"{{ logging.audit_trail }}\"\n        line: \"[{{ ansible_date_time.iso8601 }}] NOMACHINE: {{ nomachine.package_name }} - FAILED - {{ ansible_failed_result.msg | default('Unknown error') }}\"\n        create: true\n        mode: '0644'\n      when: logging.enabled | default(true)\n\n    - name: Collect failure information\n      ansible.builtin.set_fact:\n        workstation_failures: \"{{ workstation_failures | default([]) + ['NoMachine: ' + (ansible_failed_result.msg | default('Installation failed'))] }}\"\n\n    - name: \"{{ user_experience.emoji_warning | default('\u26a0\ufe0f') }} NOMACHINE | Error details\"\n      ansible.builtin.debug:\n        msg: \"NoMachine installation failed. Check {{ logging.audit_trail }} for details.\"\n\n  always:\n    - name: \"{{ user_experience.emoji_cleanup | default('\ud83e\uddf9') }} NOMACHINE | Cleanup temporary files\"\n      ansible.builtin.file:\n        path: \"{{ temp_download_dir }}/nomachine.deb\"\n        state: absent\n      when: cleanup.remove_temp_downloads | default(true)\n\n  tags:\n    - nomachine\n    - complex\n    - applications\n    - remote-access\n"
}

