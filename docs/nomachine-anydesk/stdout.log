  "content": "---\n# AnyDesk Installation\n# Configures the official AnyDesk apt repository (signed-by) and installs the client.\n# Tags: anydesk, complex, applications, remote-access\n\n- name: \"{{ user_experience.emoji_package | default('\ud83d\udce6') }} ANYDESK | Installing AnyDesk...\"\n  block:\n    - name: Check if AnyDesk is already installed\n      ansible.builtin.command:\n        cmd: dpkg -l {{ anydesk.package_name }}\n      register: anydesk_check\n      failed_when: false\n      changed_when: false\n\n    - name: \"{{ user_experience.emoji_config | default('\u2699\ufe0f') }} ANYDESK | Ensuring /etc/apt/keyrings exists...\"\n      ansible.builtin.file:\n        path: /etc/apt/keyrings\n        state: directory\n        mode: '0755'\n      become: yes\n      when: anydesk_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_working | default('\ud83d\udd04') }} ANYDESK | Downloading GPG key...\"\n      ansible.builtin.get_url:\n        url: \"{{ anydesk.gpg_url }}\"\n        dest: \"{{ temp_download_dir }}/anydesk.asc\"\n        mode: '0644'\n        timeout: \"{{ error_handling.download_timeout | default(300) }}\"\n      register: anydesk_key_download\n      retries: \"{{ error_handling.download_retries | default(3) }}\"\n      delay: \"{{ error_handling.download_delay | default(5) }}\"\n      when: anydesk_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_config | default('\u2699\ufe0f') }} ANYDESK | Installing GPG key (dearmored)...\"\n      ansible.builtin.shell:\n        cmd: \"gpg --dearmor < {{ temp_download_dir }}/anydesk.asc > {{ anydesk.keyring_path }}\"\n        creates: \"{{ anydesk.keyring_path }}\"\n      become: yes\n      when: anydesk_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_config | default('\u2699\ufe0f') }} ANYDESK | Adding apt repository...\"\n      ansible.builtin.apt_repository:\n        repo: \"{{ anydesk.repo_line }}\"\n        filename: anydesk\n        state: present\n        update_cache: false\n      become: yes\n      when: anydesk_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_working | default('\ud83d\udd04') }} ANYDESK | Updating package cache...\"\n      ansible.builtin.apt:\n        update_cache: true\n      become: yes\n      when: anydesk_check.rc != 0\n\n    - name: \"{{ user_experience.emoji_package | default('\ud83d\udce6') }} ANYDESK | Installing AnyDesk package...\"\n      ansible.builtin.apt:\n        name: \"{{ anydesk.package_name }}\"\n        state: present\n      become: yes\n      when: anydesk_check.rc != 0\n      register: anydesk_install\n\n    - name: \"{{ user_experience.emoji_success | default('\u2705') }} ANYDESK | Successfully installed\"\n      ansible.builtin.lineinfile:\n        path: \"{{ logging.audit_trail }}\"\n        line: \"[{{ ansible_date_time.iso8601 }}] ANYDESK: {{ anydesk.package_name }} - SUCCESS\"\n        create: true\n        mode: '0644'\n      when:\n        - anydesk_check.rc != 0\n        - logging.enabled | default(true)\n\n    - name: \"{{ user_experience.emoji_info | default('\u2139\ufe0f') }} ANYDESK | Installation skipped (already installed)\"\n      ansible.builtin.debug:\n        msg: \"AnyDesk is already installed - skipping installation\"\n      when: anydesk_check.rc == 0\n\n  rescue:\n    - name: \"{{ user_experience.emoji_failure | default('\u274c') }} ANYDESK | Installation failed\"\n      ansible.builtin.lineinfile:\n        path: \"{{ logging.audit_trail }}\"\n        line: \"[{{ ansible_date_time.iso8601 }}] ANYDESK: {{ anydesk.package_name }} - FAILED - {{ ansible_failed_result.msg | default('Unknown error') }}\"\n        create: true\n        mode: '0644'\n      when: logging.enabled | default(true)\n\n    - name: Collect failure information\n      ansible.builtin.set_fact:\n        workstation_failures: \"{{ workstation_failures | default([]) + ['AnyDesk: ' + (ansible_failed_result.msg | default('Installation failed'))] }}\"\n\n    - name: \"{{ user_experience.emoji_warning | default('\u26a0\ufe0f') }} ANYDESK | Error details\"\n      ansible.builtin.debug:\n        msg: \"AnyDesk installation failed. Check {{ logging.audit_trail }} for details.\"\n\n  always:\n    - name: \"{{ user_experience.emoji_cleanup | default('\ud83e\uddf9') }} ANYDESK | Cleanup temporary files\"\n      ansible.builtin.file:\n        path: \"{{ temp_download_dir }}/anydesk.asc\"\n        state: absent\n      when: cleanup.remove_temp_downloads | default(true)\n\n  tags:\n    - anydesk\n    - complex\n    - applications\n    - remote-access\n"
}

