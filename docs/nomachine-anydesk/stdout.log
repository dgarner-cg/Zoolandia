511	################################################################################
512	# MAIN MENU
513	################################################################################
514	
515	main_menu() {
516	    while true; do
517	        show_banner
518	
519	        choice=$(dialog --clear --backtitle "Nexus Workstation Setup" \
520	            --title "Main Menu" \
521	            --menu "Choose installation method:" 15 60 5 \
522	            1 "Install All (Default Configuration)" \
523	            2 "Custom Selection (Choose Apps)" \
524	            3 "Dry Run (Test Without Installing)" \
525	            4 "View Documentation" \
526	            5 "Exit" \
527	            2>&1 >/dev/tty)
528	
529	        case $choice in
530	            1)
531	                clear
532	                show_banner
533	                echo -e "${YELLOW}📦 Installing all default applications...${NC}"
534	                echo ""
535	                install_all
536	                read -p "Press ENTER to continue..."
537	                ;;
538	            2)
539	                clear
540	                # Detect already installed applications
541	                installed_apps=$(detect_installed_apps)
542	                selections=$(show_selection_menu "$installed_apps")
543	
544	                if [ -n "$selections" ]; then
545	                    # Filter out already installed apps to show only newly selected ones
546	                    new_selections=""
547	                    for item in $selections; do
548	                        if [[ ! " $installed_apps " =~ " $item " ]]; then
549	                            new_selections+="$item "
550	                        fi
551	                    done
552	
553	                    clear
554	                    show_banner
555	                    echo -e "${YELLOW}📝 Generating configuration from selections...${NC}"
556	                    generate_config_from_selections "$selections"
557	                    echo ""
558	
559	                    if [ -n "$new_selections" ]; then
560	                        echo -e "${BLUE}Newly selected items to install:${NC}"
561	                        echo "$new_selections" | tr ' ' '\n' | sed 's/^/  - /'
562	                    else
563	                        echo -e "${YELLOW}No new items selected (all selected items are already installed)${NC}"
564	                    fi
565	
566	                    if [ -n "$installed_apps" ]; then
567	                        echo ""
568	                        echo -e "${GREEN}Already installed items (will be reconfigured if needed):${NC}"
569	                        # Show which selected items are already installed
570	                        for item in $selections; do
571	                            if [[ " $installed_apps " =~ " $item " ]]; then
572	                                echo "  - $item"
573	                            fi
574	                        done
575	                    fi
576	
577	                    echo ""
578	                    read -p "Press ENTER to start installation, or Ctrl+C to cancel..."
579	                    run_ansible_with_config
580	                else
581	                    dialog --msgbox "No selections made. Returning to main menu." 8 50
582	                fi
583	                read -p "Press ENTER to continue..."
584	                ;;
585	            3)
586	                clear
587	                show_banner
588	                echo -e "${YELLOW}🔍 Running dry run (check mode)...${NC}"
589	                echo ""
590	                cd "$SCRIPT_DIR"
591	                ansible-playbook "$PLAYBOOK" --check
592	                read -p "Press ENTER to continue..."
593	                ;;
594	            4)
595	                dialog --textbox "$SCRIPT_DIR/README.md" 30 80
596	                ;;
597	            5)
598	                clear
599	                echo -e "${GREEN}Thank you for using Nexus Workstation Setup!${NC}"
600	                exit 0
601	                ;;
602	            *)
603	                dialog --msgbox "Invalid option. Please try again." 8 50
604	                ;;
605	        esac
606	    done
607	}
608	
609	################################################################################
610	# ENTRY POINT
611	################################################################################
612	
613	# Check if running as root
614	if [ "$EUID" -eq 0 ]; then
615	    echo -e "${RED}❌ Do not run this script as root (sudo)${NC}"
616	    echo -e "${YELLOW}The script will request sudo password when needed.${NC}"
617	    exit 1
618	fi
619	
620	# Check if Ansible is installed
621	if ! command -v ansible-playbook &> /dev/null; then
622	    echo -e "${YELLOW}⚠️  Ansible not found. Installing...${NC}"
623	    sudo apt-get update -qq
624	    sudo apt-get install -y ansible
625	fi
626	
627	# Verify playbook exists
628	if [ ! -f "$PLAYBOOK" ]; then
629	    echo -e "${RED}❌ Playbook not found: $PLAYBOOK${NC}"
630	    echo -e "${YELLOW}Please run this script from the ansible directory.${NC}"
631	    exit 1
632	fi
633	
634	# Start main menu
635	main_menu
636	

